{
  "name": "artice-cream",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "spike:llm": "tsx scripts/spike-llm.ts",
    "spike:sources": "tsx scripts/spike-sources.ts",
    "test:classify": "tsx tests/classify/run.ts",
    "test:logic": "tsx scripts/check-logic.ts",
    "test:quota": "tsx scripts/check-quota.ts",
    "test:quota-db": "node scripts/check-quota-db.mjs",
    "test:reader": "tsx scripts/check-reader.ts && tsx scripts/check-reader-ui.tsx",
    "test:reading-exit": "tsx scripts/check-reading-exit.tsx",
    "test:feed": "tsx scripts/check-feed-pagination.ts",
    "test:auth": "tsx scripts/check-auth-session.ts && tsx scripts/check-auth-session.ts --native",
    "test:account-delete": "tsx scripts/check-account-deletion.ts",
    "test:account-delete-ui": "tsx scripts/check-account-deletion-ui.tsx",
    "test:retention": "tsx scripts/check-data-retention.ts",
    "test:sign-in-age": "tsx scripts/check-sign-in-age.tsx",
    "test:entry": "tsx scripts/check-entry.tsx",
    "test:scoops": "tsx scripts/check-scoop-history.tsx",
    "test:scoop-arrival": "tsx scripts/check-scoop-arrival.tsx",
    "test:music": "tsx scripts/check-background-music.tsx && tsx scripts/check-background-music.tsx --native",
    "test:rights": "tsx scripts/check-content-rights.ts && tsx scripts/check-collect-rights.ts",
    "test:ingest": "tsx scripts/check-ingest.ts && tsx scripts/check-ingest-schedule.ts",
    "test:auto-review": "tsx scripts/check-auto-review.ts",
    "test:documents": "tsx scripts/check-document-sources.ts && tsx scripts/check-document-cron.ts",
    "test:originals": "tsx scripts/check-originals.ts && tsx scripts/check-originals-ui.tsx",
    "build:app": "node scripts/build-app.mjs build",
    "app:dev": "node scripts/build-app.mjs dev",
    "app:run": "node scripts/build-app.mjs run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.2.5",
    "jsdom": "26.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
