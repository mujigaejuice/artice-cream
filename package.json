{
  "name": "artice-cream",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "spike:llm": "tsx scripts/spike-llm.ts",
    "spike:sources": "tsx scripts/spike-sources.ts",
    "test:classify": "tsx tests/classify/run.ts",
    "test:logic": "tsx scripts/check-logic.ts",
    "test:quota": "tsx scripts/check-quota.ts",
    "test:quota-db": "node scripts/check-quota-db.mjs",
    "test:credits-db": "node scripts/check-credits-db.mjs",
    "test:credits": "tsx scripts/check-credits-api.ts",
    "test:credits-ui": "tsx scripts/check-credits-ui.tsx",
    "test:streak": "tsx scripts/check-streak.ts",
    "test:shop-api": "tsx scripts/check-shop-api.ts",
    "test:shop-ui": "tsx scripts/check-shop-ui.tsx && tsx scripts/check-shop-interaction.tsx && tsx scripts/check-shop-music.tsx && tsx scripts/check-scoop-colors.tsx",
    "test:reader": "tsx scripts/check-reader.ts && tsx scripts/check-reader-ui.tsx",
    "test:reading-exit": "tsx scripts/check-reading-exit.tsx && tsx scripts/check-read-confirm.tsx",
    "test:feed": "tsx scripts/check-feed-pagination.ts",
    "test:auth": "tsx scripts/check-auth-session.ts",
    "test:account-delete": "tsx scripts/check-account-deletion.ts",
    "test:onboarding": "tsx scripts/check-onboarding-quiz.ts && tsx scripts/check-onboarding-ui.tsx",
    "test:bookmarks": "tsx scripts/check-bookmarks.ts && tsx scripts/check-bookmarks-ui.tsx",
    "test:bookmarks-db": "node scripts/check-bookmarks-db.mjs",
    "test:account-delete-ui": "tsx scripts/check-account-deletion-ui.tsx",
    "test:retention": "tsx scripts/check-data-retention.ts",
    "test:sign-in-age": "tsx scripts/check-sign-in-age.tsx",
    "test:entry": "tsx scripts/check-entry.tsx",
    "test:words": "tsx scripts/check-words.ts && tsx scripts/check-words-ui.tsx",
    "test:scoops": "tsx scripts/check-scoop-history.tsx",
    "test:scoop-arrival": "tsx scripts/check-scoop-arrival.tsx",
    "test:music": "tsx scripts/check-background-music.tsx && tsx scripts/check-music-selection.tsx",
    "test:rights": "tsx scripts/check-content-rights.ts && tsx scripts/check-collect-rights.ts",
    "test:ingest": "tsx scripts/check-ingest.ts && tsx scripts/check-ingest-schedule.ts && tsx scripts/check-classify-batch.ts && tsx scripts/check-process-queue.ts",
    "test:auto-review": "tsx scripts/check-auto-review.ts",
    "test:ingest-runs": "tsx scripts/check-ingest-runs.ts",
    "report:ingest": "node --env-file-if-exists=.env.local --import=tsx scripts/report-ingest-runs.ts",
    "test:documents": "tsx scripts/check-document-sources.ts && tsx scripts/check-document-cron.ts",
    "test:originals": "tsx scripts/check-originals.ts && tsx scripts/check-originals-ui.tsx",
    "test:ci": "npm run -s test:logic && npm run -s test:quota && npm run -s test:credits && npm run -s test:credits-ui && npm run -s test:shop-api && npm run -s test:shop-ui && npm run -s test:reader && npm run -s test:reading-exit && npm run -s test:feed && npm run -s test:auth && npm run -s test:account-delete && npm run -s test:account-delete-ui && npm run -s test:retention && npm run -s test:sign-in-age && npm run -s test:entry && npm run -s test:scoops && npm run -s test:scoop-arrival && npm run -s test:music && npm run -s test:rights && npm run -s test:ingest && npm run -s test:auto-review && npm run -s test:documents && npm run -s test:originals && npm run -s test:words && npm run -s test:ingest-runs && npm run -s test:streak && npm run -s test:bookmarks && npm run -s test:onboarding",
    "test:db": "node scripts/check-quota-db.mjs && node scripts/check-credits-db.mjs && node scripts/check-bookmarks-db.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.2.5",
    "jsdom": "26.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
