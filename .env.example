# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — 둘 중 한 갈래만 채우면 된다.
# (a) OpenAI 호환 게이트웨이. 셋이 모두 있으면 파이프라인이 이쪽으로 보낸다.
BASE_URL=
MODEL_ID=
API_KEY=
# (b) Anthropic 직접 호출. 위 셋이 비어 있을 때 쓰인다.
ANTHROPIC_API_KEY=
# 모델 이름 강제 지정(선택, 두 갈래 공통)
# LLM_MODEL=

# Cron auth (Vercel sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=

# Reward-ad SSV stub signing key
AD_REWARD_SECRET=

# Optional: override daily ingest volume per domain
INGEST_ARTICLES_PER_DOMAIN=1
