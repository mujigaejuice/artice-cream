# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — 둘 중 한 갈래만 채우면 된다.
# (a) OpenAI 호환 게이트웨이. 셋이 모두 있으면 파이프라인이 이쪽으로 보낸다.
BASE_URL=
MODEL_ID=
API_KEY=
# (b) Anthropic 직접 호출.
ANTHROPIC_API_KEY=
# 모델 이름 강제 지정
# LLM_MODEL=

# Cron auth (Vercel sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=

# Reward-ad SSV stub signing key
AD_REWARD_SECRET=

# Per-run success cap; four scheduled rounds per day (up to 16 articles/domain/day).
INGEST_ARTICLES_PER_DOMAIN=4
# Split across 8 domains and 4 rounds. Costs use LLM_PRICE_PER_MTOK, or Haiku prices when unset (gateway too), so the budget stops a run.
INGEST_DAILY_BUDGET_USD=1
# 비용 추정 단가(USD / 100만 토큰): "input,output" 또는 "input,output,cacheWrite,cacheRead".
# 비우면 Haiku 단가로 추정한다(게이트웨이 포함). 게이트웨이 단가를 알면 여기에 적는다.
# LLM_PRICE_PER_MTOK=
